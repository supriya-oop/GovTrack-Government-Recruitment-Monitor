# GovTrack Environment Configuration
# Copy to .env for local development. Never commit real secrets to Git.

# Database (SQLite default for local / college project deployment)
DATABASE_URL="sqlite:///./govtrack.db"
SQLITE_DB_PATH="./govtrack.db"

# Authentication JWT Settings
JWT_SECRET_KEY="change-this-to-a-long-random-secret-key-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="720"

# Scraper & Ethical Rate-Limit Settings
SCRAPER_USER_AGENT="GovTrackMonitor/1.0 (+Academic-Research-Project; respectful-crawler)"
SCRAPER_TIMEOUT_SECONDS="10"
SCRAPER_DEFAULT_INTERVAL_MINUTES="360"
SCRAPER_RATE_LIMIT_SECONDS="2"

# Backend & Frontend Ports (Local VS Code / Windows Setup)
BACKEND_HOST="127.0.0.1"
BACKEND_PORT="8000"
FRONTEND_PORT="3000"

# Set VITE_API_PROXY_TARGET=http://127.0.0.1:8000 when running Vite against FastAPI
VITE_API_PROXY_TARGET="http://127.0.0.1:8000"

# Optional AI Studio / App URL
APP_URL="http://localhost:3000"
